{
  "name": "@fivem-nui/core",
  "version": "1.1.0",
  "description": "Framework-agnostic TypeScript bridge for FiveM NUI communication",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "default": "./dist/diagnostics/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.types.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "fivem",
    "nui",
    "typescript",
    "bridge"
  ],
  "author": "Rainbe",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
