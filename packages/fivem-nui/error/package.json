{
  "name": "@fivem-nui/error",
  "version": "1.0.0",
  "description": "Error handling utilities for FiveM NUI communication",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "fivem",
    "nui",
    "error",
    "handler",
    "typescript"
  ],
  "author": "Rainbe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rian-be/FiveM.Nui.git",
    "directory": "packages/fivem-nui/error"
  },
  "bugs": {
    "url": "https://github.com/rian-be/FiveM.Nui/issues"
  },
  "homepage": "https://github.com/rian-be/FiveM.Nui/tree/main/packages/fivem-nui/error#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}