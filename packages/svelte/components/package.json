{
  "name": "@fivem-nui/svelte-components",
  "version": "1.0.0",
  "description": "UI components for FiveM NUI built on Svelte 5",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./src": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "tsc --noEmit --skipLibCheck --moduleResolution bundler --allowJs --esModuleInterop --strict",
    "test": "npx --prefix ../bridge vitest run --config ../bridge/vitest.config.ts"
  },
  "keywords": [
    "fivem",
    "nui",
    "components",
    "svelte"
  ],
  "author": "Rainbe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rian-be/FiveM.Nui.git",
    "directory": "packages/svelte/components"
  },
  "bugs": {
    "url": "https://github.com/rian-be/FiveM.Nui/issues"
  },
  "homepage": "https://github.com/rian-be/FiveM.Nui/tree/main/packages/svelte/components#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@fivem-nui/core": "^1.0.0",
    "@fivem-nui/svelte": "^1.0.0",
    "svelte": "^5.20.0"
  },
  "dependencies": {
    "esm-env": "^1.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.0.0",
    "svelte": "^5.20.0",
    "typescript": "^5.7.3"
  }
}