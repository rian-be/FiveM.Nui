<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fivem-nui-contracts</ToolCommandName>
    <PackageId>FiveM.Nui.Contracts</PackageId>
    <Description>Generates TypeScript contract declarations from C# NUI DTOs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FiveM.Nui.csproj" />
  </ItemGroup>

</Project>
