<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <NoWarn>CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Authors>Rainbe</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="FiveM.Nui.Abstractions" />
    <Using Include="FiveM.Nui.Abstractions.Callbacks" />
    <Using Include="FiveM.Nui.Abstractions.Contracts" />
    <Using Include="FiveM.Nui.Abstractions.Diagnostics" />
    <Using Include="FiveM.Nui.Abstractions.Hosting" />
    <Using Include="FiveM.Nui.Abstractions.Lifecycle" />
    <Using Include="FiveM.Nui.Abstractions.Messaging" />
    <Using Include="FiveM.Nui.Abstractions.Windows" />
  </ItemGroup>
</Project>
